{
  "name": "kinzoku-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build": "next build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --target=node24 --outfile=dist/server.mjs --log-level=warning",
    "start": "node dist/server.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose stop",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "tsx --env-file-if-exists=.env scripts/check-db.mts",
    "staff:add": "tsx --env-file-if-exists=.env scripts/add-staff.mts",
    "retention:now": "tsx --env-file-if-exists=.env scripts/retention.mts",
    "backup:now": "docker compose run --rm backup \"sh /backup-scripts/backup.sh\"",
    "backup:restore-test": "docker compose run --rm backup \"sh /backup-scripts/restore-test.sh\"",
    "test": "playwright test"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "@next/third-parties": "^16.3.8",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "clsx": "^2.1.1",
    "croner": "10.0.1",
    "file-type": "22.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "motion": "^13.4.6",
    "next": "16.3.8",
    "nodemailer": "10.0.13",
    "radix-ui": "^1.6.7",
    "rate-limiter-flexible": "11.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.6",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "node-html-parser": "^9.0.4",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
