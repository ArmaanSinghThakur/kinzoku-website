# Local development: copy this file to .env, then choose a database password (on both lines).
# Start the database with `npm run services:up`, then create the tables with `npm run db:migrate`.
POSTGRES_PASSWORD=choose-a-password
DATABASE_URL=postgresql://kinzoku:choose-a-password@127.0.0.1:5433/kinzoku
# Where quote attachments are saved (default storage/uploads; a Docker volume on the server).
# UPLOAD_DIR=storage/uploads

# Email (Step 16). Locally every email goes to Mailpit (npm run services:up); read them at
# http://localhost:8025. On the live server: smtp.hostinger.com, port 465, and the mailbox login.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# SMTP_USER=info@kinzokutrade.com
# SMTP_PASSWORD=
# Who receives new-request alerts, and the site address used in email links.
SALES_EMAIL=info@kinzokutrade.com
SITE_URL=http://localhost:3000

# Live server only (in .env.production.local, without the #). Leave unset on staging and
# local builds so they never send data to Kinzoku's Google Analytics property.
# NEXT_PUBLIC_GA_ID=G-J0XSVBKVJ9
